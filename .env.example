# Set these in Vercel, Production environment. Never prefix private values with VITE_.
APP_ORIGIN=https://your-project.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random >=32-character private device-pairing key; enter in Settings on your own phone.
REMINDER_SETUP_KEY=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Used only on your computer by scripts/setup-reminder-schedule.mjs, not in the PWA.
QSTASH_TOKEN=
